   "source": [
    " # Check whether a given array is a palindrome\n",
    " \n",
    "left, right = 0, len(arr) - 1\n",
    "while left < right:\n",
    "        if arr[left] != arr[right]:\n",
    "            return False\n",
    "        left += 1\n",
    "        right -= 1\n",
    "    return True"
   ]
  }
